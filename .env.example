# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.

# --- Порты на хосте (контракт платформы: web 18082 / api 18002 / db 15434) ---
GRC_WEB_PORT=18082
GRC_API_PORT=18002
GRC_DB_PORT=15434

# --- База данных ---
POSTGRES_DB=grc
POSTGRES_USER=grc
# Обязательно. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Приложение ---
# Ключ подписи токенов и шифрования секретов (AES-GCM), не короче 32 символов.
# Сгенерировать: openssl rand -hex 32
GRC_SECRET_KEY=
# local — свой вход по паролю; platform — вход через «Платформу» (задача 3.5,
# docs/integration/README.md). В комплекте платформы приходит как AUTH_MODE.
GRC_AUTH_MODE=local
# Режим разработки: открывает /docs и разрешает пустой ключ. В эксплуатации — 0.
GRC_DEV_MODE=0

# Первый администратор: создаётся при первом запуске, если пользователей ещё нет.
# Пароль не короче 12 символов; после первого входа его можно сменить в интерфейсе.
GRC_BOOTSTRAP_ADMIN=admin
GRC_BOOTSTRAP_ADMIN_PASSWORD=
# Срок жизни токена доступа, минуты.
GRC_TOKEN_TTL_MINUTES=480
# Пауза после N неудачных входов подряд для одного имени.
GRC_LOGIN_MAX_FAILURES=5
GRC_LOGIN_LOCKOUT_SECONDS=300

# --- Оценка ---
# Вес статуса «Частично» в проценте реализации (0…1).
GRC_PARTIAL_WEIGHT=0.5

# --- Доказательства ---
# Файлы доказательств хранятся в томе app-data (/data/evidence), не в БД.
# Предел размера одного файла, МБ (nginx пропускает тело до 55 МБ — при увеличении
# поправьте client_max_body_size в frontend/nginx.conf).
GRC_EVIDENCE_MAX_MB=50

# --- СЗИ ---
# За сколько дней до окончания срока сертификат СЗИ показывается как истекающий.
GRC_SZI_EXPIRY_DAYS=90

# --- Документы комплекта ---
# Сформированные DOCX и PDF хранятся в томе app-data (/data/documents), не в БД.
# DOCX → PDF через LibreOffice в образе app; none — только DOCX.
GRC_PDF_CONVERTER=soffice
# Предел времени на одно преобразование в PDF, секунды.
GRC_PDF_TIMEOUT_SECONDS=120

# --- «Сканер» ---
# fixture — сохранённый ответ «Сканера» (демо, стенд без «Сканера»); live — его API.
GRC_SCANNER_MODE=fixture
# Адрес API «Сканера», например http://scanner-app:8000 или https://scanner.example/api
GRC_SCANNER_URL=
# Сервисная учётная запись «Сканера» с ролью auditor (только чтение)…
GRC_SCANNER_USERNAME=
GRC_SCANNER_PASSWORD=
# …или готовый токен вместо имени и пароля.
GRC_SCANNER_TOKEN=
GRC_SCANNER_TIMEOUT_SECONDS=20
# Корневые сертификаты для HTTPS «Сканера» (путь внутри контейнера); пусто — системные.
GRC_SCANNER_CA_FILE=

# --- «Устранение» (заявки по несоответствиям, задача 3.4) ---
# fixture — заявки создаются без «Устранения» (демо, стенд); live — его API.
GRC_VM_MODE=fixture
# Адрес API «Устранения», например http://vm-app:8000
GRC_VM_URL=
# Токен сервисной учётной записи «Устранения» (роль руководителя).
GRC_VM_TOKEN=
GRC_VM_TIMEOUT_SECONDS=20
GRC_VM_CA_FILE=
# Адрес веб-интерфейса «Устранения» для ссылок «Открыть в «Устранении»»; пусто — без ссылок.
GRC_VM_WEB_URL=
# Общий секрет подписи входящих событий vm.ticket.status_changed и
# vm.remediation.verified (POST /api/events, X-Signature: sha256=<HMAC тела>).
# Пусто — приём событий выключен, статусы обновляются кнопкой «Обновить статусы».
GRC_EVENTS_SECRET=

# --- «Платформа» (AUTH_MODE=platform, задача 3.5) ---
# Комплект платформы передаёт эти переменные без префикса GRC_ (контракт v1.1, п. 12):
#   AUTH_MODE=platform
#   PLATFORM_PRODUCT_ID=grc                         — свой id: aud токена, products.grc
#   DATABASE_URL=postgresql+psycopg://grc:…@db:5432/grc
#   PLATFORM_URL=http://platform-api:8000           — GET /projects/{id} (тени проектов)
#   PLATFORM_JWKS_URL=http://platform-api:8000/.well-known/jwks.json
#   PLATFORM_EVENTS_URL=http://platform-api:8000/events  — outbox: audit.recorded,
#                                                    grc.assessment.updated, …
#   PLATFORM_EVENTS_SECRET=…                        — HMAC событий в обе стороны
#                                                    (= GRC_EVENTS_SECRET в .env платформы)
# Отдельный запуск рядом с платформой: те же имена с префиксом GRC_.
GRC_PLATFORM_URL=
GRC_PLATFORM_JWKS_URL=
GRC_PLATFORM_EVENTS_URL=
# Доставка outbox в процессе API: пауза между проходами, секунды.
GRC_OUTBOX_POLL_SECONDS=5
# grc.assessment.updated — не чаще раза в N секунд на объект.
GRC_ASSESSMENT_EVENT_SECONDS=60

# --- Сборка фронтенда ---
# Путь SPA и префикс API. В составе платформы: VITE_BASE=/grc/, VITE_API_BASE=/api/grc,
# VITE_PLATFORM=1 (строка вкладок продуктов, вход и выход через оболочку).
VITE_BASE=/
VITE_API_BASE=/api
VITE_PLATFORM=0

# --- Демо-данные (make demo) ---
# Пароль демо-пользователей demo-meth, demo-exp, demo-boss, demo-viewer (не короче 12).
# Пусто — случайный, печатается после make demo.
GRC_DEMO_PASSWORD=
